{
  "name": "rkoomera",
  "version": "1.0.0",
  "private": true,
  "description": "Custom JavaScript for the rkoomera Webflow portfolio",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --target=es2020 --minify --sourcemap --outfile=dist/main.js",
    "dev": "node scripts/dev.mjs",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2020 --sourcemap --outfile=dist/main.js --watch",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  }
}
